# 应用配置
APP_NAME=LifeManager
APP_VERSION=1.0.0
DEBUG=True

# JWT配置
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 数据库配置
# 开发环境使用 SQLite
# DATABASE_URL=sqlite:///./lifemanager.db

# 生产环境使用 MySQL
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://lifemanager:password@localhost:3306/lifemanager?charset=utf8mb4

# 备用: PostgreSQL 配置
# DATABASE_URL=postgresql://lifemanager:password@localhost:5432/lifemanager

# OpenAI 配置 (通用 OpenAI 接口)
# 支持 OpenAI 官方 API 和所有兼容 OpenAI 接口的服务
# 示例：
#   - OpenAI 官方: https://api.openai.com/v1
#   - DeepSeek: https://api.deepseek.com
#   - 其他兼容服务: 相应的 base_url
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# 跨域配置
CORS_ORIGINS=["*"]

# 日志级别
LOG_LEVEL=INFO
