# 应用配置
APP_NAME=LifeManager
APP_VERSION=1.0.0
DEBUG=True

# JWT配置
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 数据库配置
# 开发环境使用 SQLite
DATABASE_URL=sqlite:///./lifemanager.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql://lifemanager:password@localhost:5432/lifemanager

# OpenAI配置 (DeepSeek)
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-api-key-here
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# 跨域配置
CORS_ORIGINS=["*"]

# 日志级别
LOG_LEVEL=INFO
